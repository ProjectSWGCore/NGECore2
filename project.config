[project]
	description = The ProjectSWG Open Source Core
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Viaron (Viaron)
[access "refs/for/refs/*"]
	read = group user/Viaron (Viaron)
	push = group user/Viaron (Viaron)
	label-Code-Review = -2..+2 group user/Viaron (Viaron)
	label-Verified = -1..+1 group user/Viaron (Viaron)
	rebase = group user/Viaron (Viaron)
	removeReviewer = group user/Viaron (Viaron)
	submit = group user/Viaron (Viaron)
[access "refs/heads/*"]
	read = group user/Viaron (Viaron)
	create = group user/Viaron (Viaron)
	push = +force group user/Viaron (Viaron)
	pushMerge = group user/Viaron (Viaron)
[access "refs/tags/*"]
	push = +force group user/Viaron (Viaron)
	pushTag = group user/Viaron (Viaron)
	pushSignedTag = group user/Viaron (Viaron)
[receive]
	requireSignedOffBy = true
